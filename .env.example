# PostgreSQL deployment configuration
# Never commit real credentials. Copy to a local .env and keep it untracked.
THREATLENS_DATABASE_URL=postgresql://threatlens:change-me@127.0.0.1:5432/threatlens

# Controlled network discovery defaults
THREATLENS_NETWORK_DISCOVERY_PORTS=80,443
THREATLENS_NETWORK_DISCOVERY_TIMEOUT_SECONDS=1.0
THREATLENS_NETWORK_DISCOVERY_MAX_TARGETS=64
