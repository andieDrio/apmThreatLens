# PostgreSQL deployment configuration
# Never commit real credentials. Copy to a local .env and keep it untracked.
# Runtime identity: DML only; must not own schema objects or have schema CREATE privileges.
THREATLENS_DATABASE_URL=postgresql://threatlens_runtime:change-me@127.0.0.1:5432/threatlens

# Separate deployment identity; use only for `python -m threatlens.storage.migrate`.
THREATLENS_MIGRATION_DATABASE_URL=postgresql://threatlens_migrator:change-me@127.0.0.1:5432/threatlens

# Optional NVD API key; server-side only, never put this in the browser or source control.
THREATLENS_NVD_API_KEY=

# Controlled network discovery defaults
THREATLENS_NETWORK_DISCOVERY_PORTS=80,443
THREATLENS_NETWORK_DISCOVERY_TIMEOUT_SECONDS=1.0
THREATLENS_NETWORK_DISCOVERY_MAX_TARGETS=64
